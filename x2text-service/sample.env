FLASK_ENV=production
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=3004
API_URL_PREFIX=/api/v1


# Postgres
DB_HOST=unstract-db
DB_PORT=5432
DB_USERNAME=unstract_dev
DB_PASSWORD=unstract_pass
DB_NAME=unstract_db
DB_SCHEMA="unstract"

# Unstructured API egress (the adapter's unstructured-url). Both are left
# commented so the code default applies.
# Allow private, loopback and link-local destinations (localhost, 10.x, 192.168.x,
# 169.254.x, ...). Self-hosted installs often run Unstructured on such a host, so
# unset means true. Multi-tenant deployments must set it to false.
# UNSTRUCTURED_URL_ALLOW_PRIVATE=true
# Seconds to wait for data from the Unstructured API (per socket read, so in
# practice a cap on processing time). Connect timeout is fixed at 10s.
# UNSTRUCTURED_REQUEST_TIMEOUT=900
