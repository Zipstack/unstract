FLASK_ENV=production
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=3004
API_URL_PREFIX=/api/v1


# Postgres
DB_HOST=unstract-db
DB_PORT=5432
DB_USERNAME=unstract_dev
DB_PASSWORD=unstract_pass
DB_NAME=unstract_db
DB_SCHEMA="unstract"

# Unstructured API egress (the adapter's unstructured-url). All are left
# commented so the code default applies.
# Allow private, loopback and link-local destinations (localhost, 10.x, 192.168.x,
# 169.254.x, ...). docker-compose installs often run Unstructured on such a host,
# so unset means true. A deployment serving untrusted tenants must set it to false.
# When false, redirects are also checked hop by hop.
# A URL with credentials in it (https://user:pass@host/...) is accepted when
# private destinations are allowed, and refused when this is false.
# UNSTRUCTURED_URL_ALLOW_PRIVATE=true
# When UNSTRUCTURED_URL_ALLOW_PRIVATE is false: comma-separated exact hostnames
# (no ports, schemes or wildcards) exempt from the private-destination check,
# e.g. the name of an Unstructured service on the internal network. Only list
# names no tenant can create or repoint. Unset means none.
# UNSTRUCTURED_URL_ALLOWED_HOSTS=
# Seconds to wait for data from the Unstructured API (per socket read, so in
# practice a cap on processing time). Connect timeout is fixed at 10s. Under the
# compose image the sync worker is killed at gunicorn's --timeout (930s, set in
# the image CMD), so a larger value needs that CMD overridden too.
# UNSTRUCTURED_REQUEST_TIMEOUT=900
