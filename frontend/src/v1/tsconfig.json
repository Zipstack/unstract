{
  /*
   * TypeScript config for the v1 frontend, checked by `bun run typecheck:v1`.
   * It lives here rather than beside tsconfig.json so editors pick it up for
   * files under src/v1; tsconfig.json and jsconfig.json exclude this folder.
   *
   * `allowJs: false` makes tsc skip a .js file rather than fail on it, so the
   * "TypeScript only" rule is enforced by scripts/check-v1.mjs, which
   * typecheck:v1 runs first.
   */
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "allowJs": false,
    "noEmit": true,
    /* On: vitest 3.2 ships its own chai typings and also requires
     * @types/chai ^5.2, and both declare containSubset, so library checking
     * fails TS2300 for every v1 test file. This also skips hand-written .d.ts
     * under v1. Turn this back off once vitest no longer clashes. */
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Only `@v1` and `@v1/*` — deliberately no `@/*`, so an `@/` import
     * fails typecheck as well as lint (`../` imports are caught by lint). The
     * alias is also declared in vite.config.js and vitest.config.mjs. */
    "paths": {
      "@v1": ["./index.ts"],
      "@v1/*": ["./*"]
    }
  },
  "include": ["./**/*", "../../vite-env.d.ts"]
}
