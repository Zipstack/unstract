  "additionalProperties": false,
  "properties": {
    "product": {
      "enum": ["unstract", "llm-whisperer", "verticals", "flow", null]
    },
    "updated_at": {"type": ["string", "null"], "format": "date-time"},
    "has_chosen": {"type": "boolean"}
  }
}
